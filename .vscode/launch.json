{
    "version": "0.2.0",
    "configurations": [
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md
            "name": "TaskTitan",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/bin/tasktitan/debug/task.dll",
            "launchSettingsProfile": "Debug",
            "launchSettingsFilePath": "${workspaceFolder}/src/tasktitan/Properties/launchSettings.json",
            "logging": {
                "moduleLoad": false
            },
            "console": "externalTerminal",
        },
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md
            "name": "Benchmarks",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/benchmarks/bin/Debug/net8.0/TaskTitan.Benchmarks.dll",
            "args": [],
            "cwd": "${workspaceFolder}/benchmarks",
            // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md
            "name": "Nuke",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "nukeBuild",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/.nuke/bin/Debug/_build.dll",
            "args": [
                "AssetRelease"
                // "LocalAssetRelease",
                // "--mainName",
                // "TaskTitan.Cli",
                // "--configuration",
                // "Release"
            ],
            "cwd": "${workspaceFolder}",
            // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
            "console": "externalTerminal",
            "stopAtEntry": false,
            "justMyCode": true
        },
    ]
}